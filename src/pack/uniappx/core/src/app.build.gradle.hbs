{{#each applyPlugins}}
apply plugin: '{{this}}'
{{/each}}

plugins {
    id 'com.android.application'
	{{#if project.uniapp}}
	{{else}}
	id 'org.jetbrains.kotlin.android'
	{{/if}}
}

android {
    {{#if packageName}}
    namespace '{{packageName}}'
    {{else}}
    namespace 'cn.uvuejs.app'
    {{/if}}
	{{#if project.uniapp}}
	compileSdkVersion 30
	buildToolsVersion '30.0.3'
	{{else}}
	compileSdk 35
	{{/if}}

	buildFeatures {
		{{#if buildFeatures.buildConfig}}
		buildConfig {{buildFeatures.buildConfig}}
		{{else}}
		buildConfig false
		{{/if}}
		{{#each buildFeatureEntries}}
		{{this.key}} {{this.value}}
		{{/each}}
	}

    defaultConfig {
        {{#if packageName}}
        applicationId '{{packageName}}'
        {{else}}
        applicationId 'cn.uvuejs.app'
        {{/if}}
        {{#if minSdkVersion}}
        minSdk {{minSdkVersion}}
        {{else}}
        minSdk 21
        {{/if}}
		{{#if targetSdkVersion}}
		targetSdk {{targetSdkVersion}}
		{{else}}
        targetSdk 30
		{{/if}}
        {{#if versionCode}}
        versionCode {{versionCode}}
        {{else}}
        versionCode 100
        {{/if}}
        {{#if versionName}}
        versionName '{{versionName}}'
        {{else}}
        versionName '1.0.0'
        {{/if}}

        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
        consumerProguardFiles "consumer-rules.pro"

        {{#each defaultConfig.buildConfigField}}
        buildConfigField {{{this}}}
        {{/each}}

		{{#if project.uniapp}}
		multiDexEnabled true
		{{/if}}

        ndk {
            {{#if abis}}
            abiFilters {{{abis}}}
            {{/if}}
        }

        {{#if defaultConfig.allowManifestPlaceholders}}
        manifestPlaceholders = [
            {{#each defaultConfig.manifestPlaceholderEntries}}
            "{{this.key}}" : {{#if this.isBoolean}}{{this.value}}{{else}}"{{this.value}}"{{/if}}{{#unless @last}},{{/unless}}
            {{/each}}
        ]
        {{/if}}
    }

	{{#if bundle}}
	bundle {
		language {
			enableSplit = false
		}
	}
	{{/if}}

    signingConfigs {
        config {
            storeFile file("../app/debug.keystore")
            {{#if localPack}}
            storePassword "{{keyStore.storePassword}}"
            keyAlias "{{keyStore.keyAlias}}"
            keyPassword "{{keyStore.keyPassword}}"
            {{else}}
            storePassword System.getenv("ORG_GRADLE_PROJECT_DEBUG_STORE_PASSWORD")
            keyAlias System.getenv("ORG_GRADLE_PROJECT_DEBUG_KEY_ALIAS")
            keyPassword System.getenv("ORG_GRADLE_PROJECT_DEBUG_KEY_PASSWORD")
            {{/if}}
        }
    }

    buildTypes {
        release {
            minifyEnabled false
			signingConfig signingConfigs.config
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }

        debug {
			minifyEnabled false
            signingConfig signingConfigs.config
			proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }

	{{#if project.uniapp}}
	lintOptions {
	    checkReleaseBuilds false
	    abortOnError false
	}
	{{else}}
	lintOptions {
	    checkReleaseBuilds false
	    abortOnError false
	}
	compileOptions {
	    sourceCompatibility JavaVersion.VERSION_1_8
	    targetCompatibility JavaVersion.VERSION_1_8
	}

    {{#if packagingHasJniLibs}}
    packaging {
        jniLibs {
            useLegacyPackaging {{packaging.jniLibsUseLegacyPackaging}}
        }
    }
    {{/if}}

    {{#if hasPackagingOptions}}
    packagingOptions {
        {{#each nativeLibs.pickFirsts}}
        pickFirst '{{this}}'
        {{/each}}
        {{#each nativeLibs.excludes}}
        exclude '{{this}}'
        {{/each}}
        {{#each nativeLibs.merges}}
        merge '{{this}}'
        {{/each}}
        {{#each nativeLibs.doNotStrips}}
        doNotStrip '{{this}}'
        {{/each}}
    }
    {{/if}}

    androidResources {
        // 第三方 aar（如 DCUniMPSDK、AndroidNotice）里存在旧式 %s/%d 文案，
        // AGP 8+ 在资源编译阶段会把它当成错误中断 mergeDebugResources。
        // 当前生成工程以可编译为优先，这里关闭该类格式资源的严格校验。
        ignoreAssetsPattern '!.svn:!.git:.*:!CVS:!thumbs.db:!picasa.ini:!*.scc:*~'
    }

    kotlinOptions {
        jvmTarget = '1.8'
    }
	{{/if}}

    aaptOptions {
        {{#each aaptOptions.additionalParameters}}
        additionalParameters '{{this}}'
        {{/each}}
        {{#if aaptOptions.ignoreAssetsPattern}}
        ignoreAssetsPattern '{{aaptOptions.ignoreAssetsPattern}}'
        {{/if}}
        {{#each aaptOptions.noCompress}}
        noCompress '{{this}}'
        {{/each}}
    }
}

{{#if project.uniapp}}
repositories {
    flatDir {
        dirs 'libs'
    }
}
{{/if}}

dependencies {
	implementation fileTree(include: ['*.aar', '*.jar'], dir: './libs')
	{{#if project.uniapp}}
	implementation 'androidx.recyclerview:recyclerview:1.1.0'
	implementation 'com.facebook.fresco:fresco:2.5.0'
	implementation "com.facebook.fresco:animated-gif:2.5.0"
	{{#if project.debug}}
	implementation 'com.github.bumptech.glide:glide:4.9.0'
	implementation 'com.alibaba:fastjson:1.2.83'
	implementation 'androidx.webkit:webkit:1.3.0'
	implementation 'androidx.appcompat:appcompat:1.1.0'
	implementation 'androidx.localbroadcastmanager:localbroadcastmanager:1.0.0'
	implementation 'androidx.core:core:1.1.0'
	implementation "androidx.fragment:fragment:1.1.0"
	{{/if}}
	{{else}}
    implementation 'androidx.core:core-ktx:1.9.0'
    implementation 'androidx.appcompat:appcompat:1.6.1'
    implementation 'com.google.android.material:material:1.11.0'
    testImplementation 'junit:junit:4.13.2'
    androidTestImplementation 'androidx.test.ext:junit:1.1.5'
    androidTestImplementation 'androidx.test.espresso:espresso-core:3.5.1'
    implementation project(':uniappx')
    implementation fileTree(include: ['*.aar', '*.jar'], dir: '../uniappx/libs')
    implementation "com.squareup.okhttp3:okhttp:3.12.12"
	{{/if}}
	{{#each dependencies.project}}
	implementation project('{{this}}')
	{{/each}}
    {{#each dependencies.default}}
    implementation '{{this}}'
    {{/each}}
}
